# Digunakan HANYA jika anda jalankan backend tanpa Docker (npm run dev).
# Dengan docker compose, nilai ini ditetapkan dalam docker-compose.yml.
PORT=8001
MONGO_URI=mongodb://127.0.0.1:27017/hafa
# Origin web (pilihan, pisahkan dengan koma). Aplikasi mobile tidak memerlukannya.
CLIENT_URL=http://localhost:3000
# Masukkan data contoh secara automatik jika koleksi produk kosong
AUTO_SEED=true
